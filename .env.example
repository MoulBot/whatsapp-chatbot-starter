# === WhatsApp Cloud API ===
# Token d'accès : génère un token PERMANENT via un utilisateur système
# (business.facebook.com → Paramètres → Utilisateurs système).
# Les tokens temporaires expirent après ~24h !
WHATSAPP_TOKEN=

# ID du numéro de téléphone : Meta → WhatsApp → API Setup → ton numéro
PHONE_NUMBER_ID=

# === Webhook ===
# Mot de passe que TU choisis : il doit être identique dans
# Meta → WhatsApp → Configuration → Webhook → "Vérifier le token".
VERIFY_TOKEN=mon-token-secret-123

# Clé secrète de l'app Meta (Paramètres de l'app → Généralités).
# Sert à vérifier que les requêtes POST viennent vraiment de Meta.
APP_SECRET=

# === Serveur ===
PORT=3000
